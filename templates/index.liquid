<style>
#index svg polyline,
#index svg line,
#index svg path {
  fill: none;
  stroke-width: 16;
  stroke-linecap: round;
  stroke-linejoin: round;
  transition: 0.2s;
}
#index svg circle {
  stroke: #fff;
}
#index {
  height: 80vh;
  width: fit-content;
}
@media (min-width: 640px) {
  #index {
    position: ABSOLUTE;
    top: 50%;
    left: 0;
    right: 0;
    transform: translate(0, -50%);
    height: 60vh;
    width: fit-content;
  }
}
</style>

<div id="index" class="grid grid-flow-row grid-rows-6 md:grid-rows-3 grid-cols-1 md:grid-cols-2 gap-2 m-auto pl-3 pr-3">
  <div class="transform scale-80 md:scale-115 lg:scale-100 -rotate-2 leading-tight translate-x-6 sm:translate-x-20 translate-y-10 sm:translate-y-20  -z-1">
    <svg xmlns="http://www.w3.org/2000/svg" class="inline-block w-full sm:w-7/12 stroke-current text-red" viewBox="0 0 300 125" preserveAspectRatio="xMidYMid meet">
      <path d="M28,34 C262,15 0,81 286,62">
        <animate attributeName="d" begin="0s" dur="8s"
        values="M28,34 C262,15 0,81 286,62;
                M64,23 C3,82 329,14 261,69;
                M28,34 C262,15 0,81 286,62"
        repeatCount="indefinite"
        />
      </path>
      {% comment %}
      <path style="fill: none; stroke:#000;stroke-width:3;" d="M280,68 Q270,65 272,60">
        <animate attributeName="d" begin="0s" dur="8s"
        values="M280,68 Q270,65 272,60;
                M265,69 Q255,63 258,58;
                M256,62 Q260,58 273,58;
                M265,69 Q255,63 258,58;
                M280,68 Q270,65 272,60"
        repeatCount="indefinite"
        />
      </path>
      {% endcomment %}
      <circle cx="286" cy="62" r="3" fill="black">
        <animate attributeName="cx" begin="0s" dur="8s"
        values="286;
                261;
                286"
        repeatCount="indefinite"
        />
        <animate attributeName="cy" begin="0s" dur="8s"
        values="62;
                69;
                62"
        repeatCount="indefinite"
