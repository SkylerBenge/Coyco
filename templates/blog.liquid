{% paginate blog.articles by 12 %}
<div class="mt-20 mb-20 max-w-screen-xl mx-auto">
  {% include 'about-nav' %}
  <h1 class="heading">{{ blog.title }}</h1>

  <div class="flex flex-wrap">
    {% for article in blog.articles %}
      <div class="flex flex-col transform transition-transform hover:scale-105 w-full md:w-4/12 bg-cream mx-4 px-8 py-6 rounded-xl items-center">
        <a href="{{ article.url }}">
          <h3 class="text-3xl font-dunbar font-semibold text-center mb-4">{{ article.title }}</h3>
          <img alt="{{ article.image.alt }}" src="{{ article.image.src | img_url: '300x' }}" data-src="{{ article.image.src | img_url: 'master' }}" class="w-full rounded-md lazyload" />
          <p class="text-center body">
            {% if article.excerpt.size > 0 %}
              {{ article.excerpt | strip_html | truncate: 136 }}
            {% else %}
              {{ article.content | strip_html | truncate: 136 }}
            {% endif %}
          </p>
        </a>
      </div>
    {% endfor %}
  </div>
</div>
{% if paginate.pages > 1 %}
  {{ paginate | default_pagination }}
{% endif %}

{% endpaginate %}
