{% include 'about-nav' %}
{% include 'squiggle-border' %}
<div class="flex flex-wrap">
  <h1 class="heading">How can we help you?</h1>
  <div class="flex flex-col w-full md:w-6/12 pl-6 pr-6">
    <h1 class="subhead-heavy">{{ page.title }}</h1>
    <hr class="mb-8 w-full border-4 rounded-md border-red bg-red">
    <div class="flex flex-wrap justify-between">
      <div class="w-full sm:w-1/2">
        <p class="body"><span class="font-bold">Address//</span><br>
        811 E BURNSIDE ST.<br>
        SUITE 112<br>
        PORTLAND,OR 97214
        </p>
        <p class="body">Email//  <a class="underline" target="_blank" href="mailto:coyandco@gmail.com">coyandco@gmail.com</a></p>
        <p class="body">Phone// <a class="underline" href="tel:503-893-4753">(503) 893-4753</a></p>
      </div>
      <div class="w-full sm:w-1/2">
        <p class="body"><span class="font-bold">Hours//</span><br>
          <span class="font-bold">Monday:</span> 11AM–4PM<br>
          <span class="font-bold">Tuesday:</span>	11AM–4PM<br>
          <span class="font-bold">Wednesday:</span>	11AM–6PM<br>
          <span class="font-bold">Thursday:</span>	11AM–6PM<br>
          <span class="font-bold">Friday:</span>	11AM–6PM<br>
          <span class="font-bold"> Saturday:</span>	11AM–6PM<br>
          <span class="font-bold">Sunday:</span>	Closed
        </p>
      </div>
    </div>
    <h2 class="subhead-heavy mt-8">Request a Quote</h2>
    <hr class="mb-8 w-full border-4 rounded-md border-red bg-red">
    {% form 'contact' %}
      {% if form.posted_successfully? %} Thank you for your contact {% endif %}
      {{ form.errors | default_errors }}
      <label class="block uppercase font-dunbar-tall text-black text-l font-bold mb-2" for="ContactFormName">Name</label>
      <input class="appearance-none block w-full text-black text-l border border-black rounded py-3 px-4 mb-3 bg-white focus:outline-none" type="text" id="ContactFormName" name="contact[name]">
      <label class="block uppercase font-dunbar-tall text-black text-l font-bold mb-2" for="ContactFormEmail">Email</label>
      <input class="appearance-none block w-full text-black text-l border border-black rounded py-3 px-4 mb-3 bg-white focus:outline-none"type="email" id="ContactFormEmail" name="contact[email]">
      <label class="block uppercase font-dunbar-tall text-black text-l font-bold mb-2" for="ContactFormDate">Budget</label>
      <input class="appearance-none block w-full text-black text-l border border-black rounded py-3 px-4 mb-3 bg-white focus:outline-none" type="number" id="ContactFormDate" name="contact[date]">
      <label class="block uppercase font-dunbar-tall text-black text-l font-bold mb-2" for="ContactFormDate">Project Date</label>
      <input class="appearance-none block w-full text-black text-l border border-black rounded py-3 px-4 mb-3 bg-white focus:outline-none" type="date" id="ContactFormDate" name="contact[date]">
      <label class="block uppercase font-dunbar-tall text-black text-l font-bold mb-2" for="ContactFormMessage">Project Description</label>
      <textarea class="appearance-none block w-full text-black text-l border border-black rounded py-3 px-4 mb-3 bg-white focus:outline-none" rows="10" id="ContactFormMessage" name="contact[body]"></textarea>
      <input class="shadow uppercase text-2xl font-dunbar-tall bg-black hover:bg-red text-l focus:shadow-outline focus:outline-none text-cream font-bold py-2 px-4 rounded" type="submit" value="send">
    {% endform %}
  </div>
  <div class="flex flex-col w-full md:w-6/12 pl-6 pr-6">
    <h2 class="subhead-heavy">Frequently Asked Questions</h2>
    <hr class="mb-8 w-full border-4 rounded-md border-red bg-red">
    {% for block in section.blocks %}
      <h3 class="subhead">{{ block.settings.question }}</h3>
      <div class="body">{{ block.settings.answer }}</div>
    {% endfor %}
    {% include 'google-map' %}
    <a href="https://trimet.org/#/planner"  class="bg-black text-cream text-center px-6 py-3 mt-6 text-2xl font-dunbar-tall font-semibold rounded hover:bg-red hover:text-black">Plan your trip to coy &amp; co. on Trimet!</a>
  </div>
</div>

{% schema %}
  {
    "name": "Contact Us",
    "class": "mt-20 mb-20 max-w-screen-xl mx-auto relative",
    "settings": [
    ],
    "blocks": [
      {
        "type": "text",
        "name": "FAQ",
        "settings": [
          {
            "type": "text",
            "id": "question",
            "label": "Question"
          },
          {
            "type": "richtext",
            "id": "answer",
            "label": "Answer"
          }
        ]
      }
	  ]
  }
{% endschema %}