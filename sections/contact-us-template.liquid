<div class="flex flex-wrap">
  <div class="flex flex-col w-full md:w-6/12 pl-6 pr-6">
    <h1 class="text-4xl font-ubuntu-heavy text-center mb-12">{{ page.title }}</h1>
    {% form 'contact' %}
      {% if form.posted_successfully? %} Thank you for your contact {% endif %}
      {{ form.errors | default_errors }}
      <label class="block uppercase font-ubuntu text-black text-l font-bold mb-2" for="ContactFormName">Name</label>
      <input class="appearance-none block w-full text-black text-l border border-black rounded py-3 px-4 mb-3 bg-white focus:outline-none" type="text" id="ContactFormName" name="contact[name]">
      <label class="block uppercase font-ubuntu text-black text-l font-bold mb-2" for="ContactFormEmail">Email</label>
      <input class="appearance-none block w-full text-black text-l border border-black rounded py-3 px-4 mb-3 bg-white focus:outline-none"type="email" id="ContactFormEmail" name="contact[email]">
      <label class="block uppercase font-ubuntu text-black text-l font-bold mb-2" for="ContactFormDate">Budget</label>
      <input class="appearance-none block w-full text-black text-l border border-black rounded py-3 px-4 mb-3 bg-white focus:outline-none" type="number" id="ContactFormDate" name="contact[date]">
      <label class="block uppercase font-ubuntu text-black text-l font-bold mb-2" for="ContactFormDate">Project Date</label>
      <input class="appearance-none block w-full text-black text-l border border-black rounded py-3 px-4 mb-3 bg-white focus:outline-none" type="date" id="ContactFormDate" name="contact[date]">
      <label class="block uppercase font-ubuntu text-black text-l font-bold mb-2" for="ContactFormMessage">Project Description</label>
      <textarea class="appearance-none block w-full text-black text-l border border-black rounded py-3 px-4 mb-3 bg-white focus:outline-none" rows="10" id="ContactFormMessage" name="contact[body]"></textarea>
      <input class="shadow uppercase font-ubuntu bg-black hover:bg-red text-l focus:shadow-outline focus:outline-none text-cream font-bold py-2 px-4 rounded" type="submit" value="send">
    {% endform %}
  </div>
  <div class="flex flex-col w-full md:w-6/12 pl-6 pr-6">
    <h1 class="text-4xl font-ubuntu-heavy text-center mb-12">Frequently Asked Questions</h1>
    {% for block in section.blocks %}
      <h3 class="text-3xl font-ubuntu">{{ block.settings.question }}</h3>
      <div class="body">{{ block.settings.answer }}</div>
    {% endfor %}
  </div>
</div>

{% schema %}
  {
    "name": "Contact Us",
    "class": "mt-20 mb-20 max-w-screen-xl mx-auto",
    "settings": [
    ],
    "blocks": [
      {
        "type": "text",
        "name": "FAQ",
        "settings": [
          {
            "type": "text",
            "id": "question",
            "label": "Question"
          },
          {
            "type": "richtext",
            "id": "answer",
            "label": "Answer"
          }
        ]
      }
	  ]
  }
{% endschema %}