<nav class="flex items-center justify-between flex-wrap p-6">
  <ul class="max-w-max">
    {% for link in linklists.main-menu.links %}
      {% assign child_list_handle = link.title | handleize %}
      {% if linklists[child_list_handle].links != blank %}
        <a href="{{ link.url }}">
          {{ link.title }}
        </a>
        [{% for childlink in linklists[child_list_handle].links %}
          <a href="{{ childlink.url }}">
          {{ link.title }}
          </a>
        {% endfor %}]
      {% else %}
      {% if forloop.index == 1 %}
        {% capture nav_classes %}
          "transform translate-x-20"
        {% endcapture %}
      {% elsif forloop.index == 2 %}
        {% capture nav_classes %}
          "transform rotate-6 translate-x-16 translate-y-4"
        {% endcapture %}
      {% elsif forloop.index == 3 %}
        {% capture nav_classes %}
          "transform rotate-12 translate-x-12 translate-y-8"
        {% endcapture %}
      {% endif %}
      <li class={{ nav_classes }}>
        <a href="{{ link.url }}">
          <button class="bg-black text-cream px-4 py-2 text-xl font-bungee-inline tracking-wider text-white rounded hover:bg-red hover:text-black">{{ link.title }}</button>
        </a>
      </li>
      {% endif %}
    {% endfor %}
  </ul>

  <div class="z-1">
    <a href="/" class="inline-block">{% include 'logo' %}</a>
  </div>

  <div class="transform z-1 relative -translate-x-20">
    <a href="/cart" class="inline-block w-16">{% include 'cart-icon' %}</a>
    <div id="CartCount" class="absolute bottom-0 right-0 px-2 bg-black text-cream rounded {% if cart.item_count == 0 %} hidden{% endif %}">
      <span class="font-bungee text-sm">{{ cart.item_count }}</span>
    </div>

    {% if shop.customer_accounts_enabled %}
      {% if customer %}
        <a href="/account">account</a>
        {{ 'log out'  | customer_logout_link }}
      {% else %}
        {{ 'log in ' | customer_login_link }}
        {{ 'register' | customer_register_link }}
      {% endif %}
    {% endif %}
  </div>
</nav>