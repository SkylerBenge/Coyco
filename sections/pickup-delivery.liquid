<style>
.slide-button.selected {
  background-color: #222222;
}
 input:checked + svg {
  	display: block;
  }
</style>
{{ 'jquery-ui.css' | asset_url | stylesheet_tag }}
{{ 'jquery.timepicker.css' | asset_url | stylesheet_tag }}
{{ 'jquery-ui.min.js' | asset_url | script_tag }}
{{ 'jquery.timepicker.min.js' | asset_url | script_tag }}
<hr class="mt-8 mb-8 w-full border-4 rounded-md border-red bg-red">
<div class="container mx-auto">
  <div class="choice">
    <div class="flex flex-wrap">
      {% assign subscription_options = 'Pick-Up,Delivery' | split: ',' %}
      {% for subscription_option in subscription_options %}
        {% assign flower_index = forloop.index %}
        <div class="flex flex-col w-full md:w-6/12 pl-6 pr-6">
          {% for block in section.blocks %}
            {% if forloop.index == flower_index %}
              {% capture image %}
                <img alt="{{ block.settings.flower_image.alt | escape }}" src="{{ block.settings.flower_image | img_url: '300x' }}" data-src="{{ block.settings.flower_image | img_url: 'master' }}" class="w-6/12 mx-auto lazyload rounded-lg" />
              {% endcapture %}
              {% capture title %}
                <h3 class="subhead text-center mt-8">{{ block.settings.flower_option }}</h3>
              {% endcapture %}
              {% capture text %}
                <p class="body text-center">{{ block.settings.flower_text }}</p>
              {% endcapture %}
              {% capture note %}
                {% if block.settings.flower_note != blank %}
                  <p class="body text-center"><i>{{ block.settings.flower_note }}</i></p>
                {% endif %}
              {% endcapture %}
              {% assign flower_number = flower_number | plus: 1 %}
            {% endif %}
          {% endfor %}
          {{image}}
          {{ title }}
          {{ text }}
          <button class="w-60 sm:w-40 bg-red hover:bg-black text-cream px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall mx-auto mb-8 mt-4 font-semibold sm:tracking-wider rounded slide-button" type="button" value={{subscription_option}}  name={{subscription_option | downcase }}>Select</button>
          {{ note }}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="choice hidden map">
    <hr class="mx-auto mt-8 mb-8 w-full border-4 rounded-md border-black bg-black">
    {% include 'map' %}

    {% for product in collection.products %}
      {% if product.title == "Delivery Fee" %}
      {% for variant in product.variants %}
        <input type="checkbox" class="distance-check hidden" id="{{ variant.title | downcase | handleize }}" data-id="{{variant.id}}" data-price="{{variant.price}}">
      {% endfor %}
      {% endif %}
    {% endfor %}
  </div>

  <div class="choice hidden product-type">
    <hr class="mx-auto mt-8 mb-8 w-full border-4 rounded-md border-black bg-black">
    <h2 class="subhead-heavy mt-8">Product Type</h2>
    <div class="flex flex-wrap">
      {% assign subscription_options = 'Bouquet,Wreath' | split: ',' %}
      {% for subscription_option in subscription_options %}
        {% assign flower_index = forloop.index | plus: 2 %}
        <div class="flex flex-col w-full md:w-6/12 pl-6 pr-6">
        {% for block in section.blocks %}
            {% if forloop.index == flower_index %}
              {% capture image %}
                <img alt="{{ block.settings.flower_image.alt | escape }}" src="{{ block.settings.flower_image | img_url: '300x' }}" data-src="{{ block.settings.flower_image | img_url: 'master' }}" class="w-6/12 mx-auto lazyload rounded-lg" />
              {% endcapture %}
              {% capture title %}
                <h3 class="subhead text-center mt-8">{{ block.settings.flower_option }}</h3>
              {% endcapture %}
              {% capture text %}
                <p class="body text-center">{{ block.settings.flower_text }}</p>
              {% endcapture %}
              {% capture note %}
                {% if block.settings.flower_note != blank %}
                  <p class="body text-center"><i>{{ block.settings.flower_note }}</i></p>
                {% endif %}
              {% endcapture %}
              {% assign flower_number = flower_number | plus: 1 %}
            {% endif %}
          {% endfor %}
          {{image}}
          {{ title }}
          {{ text }}
          <button class="w-60 sm:w-40 bg-red hover:bg-black text-cream px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall mx-auto mb-8 mt-4 font-semibold sm:tracking-wider rounded slide-button" type="button" name={{ subscription_option }} value={{subscription_option | downcase }}>Select</button>
          {{ note }}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="choice hidden bouquet-size">
    <hr class="mx-auto mt-8 mb-8 w-full border-4 rounded-md border-black bg-black">
    <h2 class="subhead-heavy mt-8">Container Type</h2>
    <div class="flex flex-wrap">
      {% assign subscription_options = 'Hand-Tied,Vase,Full,Half' | split: ',' %}
      {% for subscription_option in subscription_options %}
        {% assign flower_index = forloop.index | plus: 4 %}
        <div class="flex flex-col w-full md:w-6/12 pl-6 pr-6 {% if subscription_option == 'Hand-Tied' or subscription_option == 'Vase' %}arrangement{% else %}wreath{% endif %}">
        {% for block in section.blocks %}
            {% if forloop.index == flower_index %}
              {% capture image %}
                <img alt="{{ block.settings.flower_image.alt | escape }}" src="{{ block.settings.flower_image | img_url: '300x' }}" data-src="{{ block.settings.flower_image | img_url: 'master' }}" class="w-6/12 mx-auto lazyload rounded-lg" />
              {% endcapture %}
              {% capture title %}
                <h3 class="subhead text-center mt-8">{{ block.settings.flower_option }}</h3>
              {% endcapture %}
              {% capture text %}
                <p class="body text-center">{{ block.settings.flower_text }}</p>
              {% endcapture %}
              {% capture note %}
                {% if block.settings.flower_note != blank %}
                  <p class="body text-center"><i>{{ block.settings.flower_note }}</i></p>
                {% endif %}
              {% endcapture %}
              {% assign flower_number = flower_number | plus: 1 %}
            {% endif %}
          {% endfor %}
          {{image}}
          {{ title }}
          {{ text }}
          <button class="w-60 sm:w-40 bg-red hover:bg-black text-cream px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall mx-auto mb-8 mt-4 font-semibold sm:tracking-wider rounded slide-button" type="button" name="{{ subscription_option }}" value="{{ subscription_option }}">Select</button>
          {{ note }}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="choice hidden bouquet">
    <hr class="mx-auto mt-8 mb-8 w-full border-4 rounded-md border-black bg-black">
    <h2 class="subhead-heavy mt-8">Size</h2>

    <div class="flex flex-wrap">
      {% assign subscription_options = 'Small Vase,Medium Vase, Large Vase,Small Hand-Tied,Medium Hand-Tied,Large Hand-Tied' | split: ',' %}
      {% for subscription_option in subscription_options %}
        {% assign flower_index = forloop.index | plus: 8 %}
        <div class="flex flex-col w-full md:w-4/12 pl-6 pr-6{% if subscription_option contains 'Vase' %} vase{% else %} hand-tied{% endif %}">
        {% for block in section.blocks %}
            {% if forloop.index == flower_index %}
              {% capture image %}
                <img alt="{{ block.settings.flower_image.alt | escape }}" src="{{ block.settings.flower_image | img_url: '300x' }}" data-src="{{ block.settings.flower_image | img_url: 'master' }}" class="w-9/12 mx-auto lazyload rounded-lg" />
              {% endcapture %}
              {% capture title %}
                <h3 class="subhead text-center mt-8">{{ block.settings.flower_option }}</h3>
              {% endcapture %}
              {% capture text %}
                <p class="body text-center">{{ block.settings.flower_text }}</p>
              {% endcapture %}
              {% capture note %}
                {% if block.settings.flower_note != blank %}
                  <p class="body text-center"><i>{{ block.settings.flower_note }}</i></p>
                {% endif %}
              {% endcapture %}
              {% assign flower_number = flower_number | plus: 1 %}
            {% endif %}
          {% endfor %}
          {{ image }}
          {{ title }}
          {{ text }}
          <button class="w-60 sm:w-40 bg-red hover:bg-black text-cream px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall mx-auto mb-8 mt-4 font-semibold sm:tracking-wider rounded slide-button" type="button" name="{{subscription_option | downcase }}" value="{{ subscription_option | downcase  | split: ' ' | first }}">Select</button>
          {{ note }}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="choice hidden pickup-time">
    <hr class="mx-auto mt-8 mb-8 w-full border-4 rounded-md border-black bg-black">
    <h2 class="subhead-heavy mt-8">What Day?</h2>

    <div class="flex flex-wrap justify-center">
      <div class="flex flex-col w-10/12 md:w-6/12 pl-6 pr-6">
        <h3 class="subhead text-center mt-8">Date:</h3> <input type="text" id="my_date_picker" class="appearance-none block w-full text-black text-l border-2 text-2xl text-center font-dunbar-tall border-black rounded py-3 px-4 mt-3 mb-3 bg-white focus:outline-none" value="Choose A Date">
        <button disabled id="my_date_button" class="w-60 sm:w-40 bg-red hover:bg-black text-cream px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall mx-auto mb-8 mt-4 font-semibold sm:tracking-wider rounded slide-button" type="button">Select</button>
        <p class="body text-center delivery-time hidden"><i>Your flowers will be delivered on the date selected anytime between 12pm - 7pm. We cannot schedule delivery times due to variability in between delivery orders. You will receive a text message from our delivery driver when we are on our way and again when it has been delivered. If the order is extremely time sensitive we encourage our customers to select pick-up instead. If you selected a hand-tied bouquet and are not sure if you or the recipient will be home we suggest leaving a vase of water out for us to place the flowers in or ordering an arrangement in a vase instead.</i></p>
      </div>
    </div>
  </div>

  <div class="choice hidden time">
    <hr class="mx-auto mt-8 mb-8 w-full border-4 rounded-md border-black bg-black">
    <h2 class="subhead-heavy mt-8">When?</h2>

    <div class="flex flex-wrap justify-center">
      <div class="flex flex-col w-10/12 md:w-6/12 pl-6 pr-6">
        <p class="body text-center">We're Open for Pick-Up 11 am - 4 pm</p>
        <h3 class="subhead text-center mt-8">Time:</h3> <input type="text" class="timepicker appearance-none block w-full text-black text-l border-2 text-2xl text-center font-dunbar-tall border-black rounded py-3 px-4 mt-3 mb-3 bg-white focus:outline-none">
        <p class="body text-center">We will have your order ready by the time you selected</p>
        <button id="my_time_button" class="w-60 sm:w-40 bg-red hover:bg-black text-cream px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall mx-auto mb-8 mt-4 font-semibold sm:tracking-wider rounded slide-button" type="button" value="12:00">Select</button>
      </div>
    </div>
  </div>

  <div class="choice hidden">
    <hr class="mx-auto mt-8 mb-8 w-full border-4 rounded-md border-black bg-black">
    <h2 class="subhead-heavy mt-8">Colors?</h2>

    <div class="flex flex-wrap justify-center">
      {% for product in collection.products %}
        {% if product.title == "Color" %}
        {% for variant in product.variants %}
          <div class="flex flex-col w-6/12 md:w-1/3 lg:w-1/4 xl:w-1/5 pl-6 pr-6 relative">
            <img alt="{{ variant.image.alt | escape }}" src="{{ variant.image | img_url: '300x' }}" data-src="{{ variant.image | img_url: 'master' }}" class="w-9/12 h-40 mx-auto lazyload rounded-lg" />
            <h3 class="subhead text-center mt-8">{{ variant.title }}</h3>
            <div class="border-2 rounded-lg border-black absolute right-12 left-12 top-0 h-40 items-center focus-within:border-red">
              <input type="checkbox" class="color-check opacity-0 absolute w-full h-full" value="{{ variant.title }}" data-id="{{variant.id}}">
              <svg class="fill-current hidden w-full h-full text-black pointer-events-none" viewBox="0 0 100 100">
                <rect x="0" y="0" width="100" height="100" rx="20" ry="20" fill="transparent"></rect>
                <line x1="30" y1="30" x2="70" y2="70" stroke="#000" stroke-width="10" stroke-linecap="round"></line>
                <line x1="30" y1="70" x2="70" y2="30" stroke="#000" stroke-width="10" stroke-linecap="round"></line>
              </svg>
            </div>
          </div>
        {% endfor %}
        {% endif %}
      {% endfor %}
    </div>

    <p class="body text-center">Any other aesthetic preferences you'd like us to consider? (Max 300 Characters)</p>
    <textarea class="color-instructions appearance-none block h-20 w-full text-black text-l border border-black rounded py-3 px-4 mb-3 bg-white focus:outline-none" maxlength="300" rows="10" id="ColorNote"></textarea>

    <button disabled id="color-button" class="block w-60 sm:w-40 bg-red hover:bg-black text-cream px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall mx-auto mb-8 mt-4 font-semibold sm:tracking-wider rounded slide-button color-button" type="button" value="color" >Submit</button>
  </div>

  <div class="choice hidden note">
    <hr class="mx-auto mt-8 mb-8 w-full border-4 rounded-md border-black bg-black">
    <h2 class="subhead-heavy mt-8">Add a note?</h2>

    <p class="body text-center">Would you like to include a note to the recipient? It will come hand-written on a piece of paper (Note will be in card if Chosen otherwise will be on slip of paper max 150 characters)</p>

    <textarea class="note-instructions appearance-none block h-20 w-full text-black text-l border border-black rounded py-3 px-4 mb-3 bg-white focus:outline-none" maxlength="150" rows="10" id="CardNote"></textarea>

    <h2 class="subhead-heavy mt-8">Upgrade to card?</h2>
    <div class="flex flex-wrap justify-center">
      <button class="block w-auto bg-red hover:bg-black text-cream px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall mx-auto mb-8 mt-4 font-semibold sm:tracking-wider rounded card-button color-button" type="button" value="color" >Yes ($6 per card)</button>
      <button class="block w-60 sm:w-40 bg-red hover:bg-black text-cream px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall mx-auto mb-8 mt-4 font-semibold sm:tracking-wider rounded slide-button color-button" type="button" value="color" >No</button>
    </div>
    <div class="card-choices hidden">
      <div class="card-choices flex flex-wrap justify-center">
        {% for product in collection.products %}
          {% if product.title == "Cards" %}
          {% for variant in product.variants %}
            <div class="flex flex-col w-6/12 md:w-1/3 lg:w-1/4 xl:w-1/5 pl-6 pr-6 relative">
              <img alt="{{ variant.image.alt | escape }}" src="{{ variant.image | img_url: '300x' }}" data-src="{{ variant.image | img_url: 'master' }}" class="w-9/12 h-40 mx-auto lazyload rounded-lg" />
              <h3 class="subhead text-center mt-8">{{ variant.title }}</h3>
              <div class="card-check-container border-2 rounded-lg border-black absolute right-12 left-12 top-0 h-40 items-center focus-within:border-red">
                <input type="checkbox" class="card-check opacity-0 absolute w-full h-full" value="{{ variant.title }}" data-id="{{variant.id}}" data-price="{{variant.price}}">
                <svg class="fill-current hidden w-full h-full text-black pointer-events-none" viewBox="0 0 100 100">
                  <rect x="0" y="0" width="100" height="100" rx="20" ry="20" fill="transparent"></rect>
                  <line x1="30" y1="30" x2="70" y2="70" stroke="#000" stroke-width="10" stroke-linecap="round"></line>
                  <line x1="30" y1="70" x2="70" y2="30" stroke="#000" stroke-width="10" stroke-linecap="round"></line>
                </svg>
              </div>
            </div>
          {% endfor %}
          {% endif %}
        {% endfor %}
      </div>
      <button class="block w-60 sm:w-40 bg-red hover:bg-black text-cream px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall mx-auto mb-8 mt-4 font-semibold sm:tracking-wider rounded slide-button card-button" type="button" value="card" >Submit</button>
    </div>
  </div>

  <div class="order-summary choice hidden">
    <ul>
      <li>
        <hr class="mx-auto mt-8 mb-8 w-full border-2 rounded-md border-black bg-black">
        <p class="subhead">Order Type: <span class="product-order"></span>
      </li>
      <li class="hidden">
        <hr class="mx-auto mt-8 mb-8 w-full border-2 rounded-md border-black bg-black">
        <p class="subhead">Address: <span class="product-delivery"></span>
      </li>
      <li>
        <hr class="mx-auto mt-8 mb-8 w-full border-2 rounded-md border-black bg-black">
        <p class="subhead">Size: <span class="product-size"></span>
      </li>
      <li>
        <hr class="mx-auto mt-8 mb-8 w-full border-2 rounded-md border-black bg-black">
        <p class="subhead">Container Type: <span class="product-container"></span>
      </li>
      <li>
        <hr class="mx-auto mt-8 mb-8 w-full border-2 rounded-md border-black bg-black">
        <p class="subhead">Delivery Dates: <span class="product-day"></span>
      </li>
      <li class='time-summary'>
        <hr class="mx-auto mt-8 mb-8 w-full border-2 rounded-md border-black bg-black">
        <p class="subhead">Time: <span class="product-time"></span>
      </li>
      <li>
        <hr class="mx-auto mt-8 mb-8 w-full border-2 rounded-md border-black bg-black">
        <p class="subhead">Colors: <span class="product-colors"></span>
      </li>
      <li class='card-summary'>
        <hr class="mx-auto mt-8 mb-8 w-full border-2 rounded-md border-black bg-black">
        <p class="subhead">Card: <span class="product-cards"></span><span class="product-cards-price"></span>
      </li>
      <li>
        <hr class="mx-auto mt-8 mb-8 w-full border-2 rounded-md border-black bg-black">
        <p class="subhead">Delivery: $<span class="product-price"></span>
      </li>
      <li>
        <hr class="mx-auto mt-8 mb-8 w-full border-2 rounded-md border-black bg-black">
        <p class="subhead">Flowers: $<span class="product-price"></span>
      </li>
      <li>
        <hr class="mx-auto mt-8 mb-8 w-full border-2 rounded-md border-black bg-black">
        <p class="subhead">Total: $<span class="product-price"></span>
      </li>
    </ul>

    <div class="flex flex-wrap justify-center my-20">
      <button class="w-full hover:bg-black bg-red text-cream uppercase px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall font-semibold sm:tracking-wider rounded add-to-cart">Add to Cart</button>
      <button class="w-full hover:bg-black mt-8 bg-red text-cream uppercase px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall font-semibold sm:tracking-wider rounded checkout-button hidden"><a href="/checkout">Checkout</a></button>
      <button class="w-full hover:bg-black mt-8 bg-red text-cream uppercase px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall font-semibold sm:tracking-wider rounded checkout-button hidden"><a href="/pages/shop">Keep Browsing</a></button>
    </div>
  </div>
</div>

<div class="products">
  {% for product in collection.products %}
    {% unless product.title == "Color" or product.title == "Cards" %}
      {% for variant in product.variants %}
        <span class="variants hidden" data-handle="{{ product.handle }}" data-id="{{ variant.id }}" data-price="{{ variant.price }}" data-option1="{{ variant.option1 }}" data-option2="{{ variant.option2 }}">{{ variant.title }}</span>
      {% endfor %}
    {% endunless %}
  {% endfor %}
</div>

<div class="chosen">
  <span class="variant hidden" data-handle=""></span>
</div>
{{ 'flower-order.js' | asset_url | script_tag }}

{% schema %}
  {
    "name": "Collection header",
    "class": "mt-20 mb-20 max-w-screen-xl mx-auto relative",
    "blocks": [
      {
        "type": "image",
        "name": "Slide",
        "settings": [
          {
            "type": "header",
            "content": "Flower Choice"
          },
          {
            "type": "image_picker",
            "id": "flower_image",
            "label": "Flower image"
          },
          {
            "type": "text",
            "id": "flower_text",
            "label": "Flower text"
          },
          {
            "type": "text",
            "id": "flower_option",
            "label": "Flower option"
          },
          {
            "type": "text",
            "id": "flower_note",
            "label": "Flower note"
          }
        ]
      }
    ]
  }
{% endschema %}
