{% include 'about-nav' %}
{% comment %}
{% include 'squiggle-border' %}
{% endcomment %}
<h1 class="heading">{{ page.title }}</h1>
<div>
  {% for block in section.blocks %}
    {% if block.settings.category != blank %}
      <h1 class="subhead-heavy">{{ block.settings.category }}</h1>
    {% endif %}
    <div class="flex flex-wrap">
      {% if block.settings.image_location == "left" %}
        <div class="w-full md:w-4/12 pl-6 pr-6">
          <img alt="{{ block.settings.image.alt | escape }}" src="{{ block.settings.image | img_url: '300x' }}" data-src="{{ block.settings.image | img_url: 'master' }}" class="w-full lazyload rounded-sm" />
        </div>
      {% endif %}

      <div class="w-full md:w-8/12 pl-6 pr-6">
        <h3 class="subhead">{{ block.settings.name }}</h3>
        <div class="body">{{ block.settings.info }}</div>
        <p class="font-dunbar-tall body">Read More: <a class="text-red" target="_blank" href="{{ block.settings.link }}">{{ block.settings.link_text }}</a></p>
        <div class="body">{{ block.settings.info_2 }}</div>
      </div>

      {% if block.settings.image_location == "right" %}
        <div class="w-full md:w-4/12 pl-6 pr-6">
          <img alt="{{ block.settings.image.alt | escape }}" src="{{ block.settings.image | img_url: '300x' }}" data-src="{{ block.settings.image | img_url: 'master' }}" class="w-full lazyload rounded-sm" />
        </div>
      {% endif %}
    </div>
    <hr class="mt-8 mb-8 w-full border-2 border-red bg-red">
  {% endfor %}
</div>

{% schema %}
  {
    "name": "Vendors",
    "class": "mt-20 mb-20 max-w-screen-xl mx-auto relative",
    "settings": [
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Vendor",
        "settings": [
          {
            "type": "text",
            "id": "category",
            "label": "Page category"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Vendor image"
          },
          {
            "type": "select",
            "id": "image_location",
            "label": "Image position",
            "options": [
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "right",
                "label": "Right"
              }
            ],
            "default": "left"
          },
          {
            "type": "text",
            "id": "name",
            "label": "Vendor name"
          },
          {
            "type": "richtext",
            "id": "info",
            "label": "Vendor info"
          },
          {
            "type": "text",
            "id": "link_text",
            "label": "Vendor name"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Vendor link"
          },
          {
            "type": "richtext",
            "id": "info_2",
            "label": "More vendor info"
          }
        ]
      }
	  ]
  }
{% endschema %}