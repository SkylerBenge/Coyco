<div class="mt-20 mb-20 max-w-screen-xl mx-auto">
  {% include 'about-nav' %}

  <h1 class="subhead-heavy">{{ article.title }}</h1>

  <div class="flex flex-wrap">
    <img alt="{{ article.image.alt }}" src="{{ article.image.src | img_url: '500x' }}" data-src="{{ article.image.src | img_url: 'master' }}" class="w-full self-center md:w-4/12 px-6 rounded-md lazyload" />
    <div class="w-full md:w-8/12 px-6">
      <div>{{ article.excerpt }}</div>
    </div>
  </div>
  <div class="grid article-grid">{{ article.content }}</div>
</div>

{% include 'mosaic' %}