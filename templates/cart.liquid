<style>
  table {
    border-spacing: 2rem;
  }
</style>

<div class="mt-20 mb-20 max-w-screen-xl mx-auto relative">
  <hr class="mt-8 mb-8 w-full border-4 rounded-md border-red bg-red">
  <h1 class="heading">cart</h1>
  {% if cart.item_count > 0 %}
    <form action="/cart" method="post" novalidate>
      <table class="mx-auto border-separate">
        <thead>
          <th class="subhead text-left" colspan="2">Product</th>
          <th class="subhead text-left">Price</th>
          <th class="subhead text-left">Qty</th>
          <th class="subhead text-left">Total</th>
        </thead>
        <tbody class="body mt-8">
          {% for item in cart.items %}
            <tr>
              <td>
                <a href="{{ item.url | within: collections.all }}">
                  <img src="{{ item | img_url: 'medium' }}" alt="{{ item.title | escape }}">
                </a>
              </td>
              <td>
                <p class="mb-8">{{ item.product.title }} {{ item.variant.title }}</p>
                <a class="text-sm" href="/cart/change?line={{ forloop.index }}&amp;quantity=0">remove</a>
              </td>
              {% unless item.product.handle == "color" %}
              <td>
                <p class="mb-8">{{ item.price | money }}</p>
              </td>
              <td>
                <input class="mb-8 w-12 text-right" type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0">
              </td>
              <td>
                {% if item.original_line_price != item.line_price %}{{ item.original_line_price | money }}{% endif %}
                <p class="mb-8">{{ item.line_price | money }}</p>
                {% for discount in item.discounts %}{{ discount.title }}{% endfor %}
              </td>
              {% endunless %}
            </tr>
            <tr>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <div class="flex flex-wrap justify-around mt-12">
        <p class="subhead">Subtotal : {{ cart.total_price | money }}</p>
        <button class="w-full sm:w-60 hover:bg-black bg-red text-cream uppercase px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall font-semibold sm:tracking-wider rounded" type="submit" name="update">Update</button>
        <button class="w-full sm:w-60 hover:bg-black bg-red text-cream uppercase px-2 sm:px-6 py-1 sm:py-3 text-2xl font-dunbar-tall font-semibold sm:tracking-wider rounded" type="submit" name="checkout">Checkout</button>
      </div>
    </form>
  {% endif %}
</div>