<div>
  {% for block in section.blocks %}
    {% if block.settings.category != blank %}
      <h1 class="text-4xl w-full text-center font-ubuntu-heavy text-center mb-12">{{ block.settings.category }}</h1>
    {% endif %}
    <div class="flex">
      {% if block.settings.image_location == "left" %}
        <div class="w-full md:w-4/12 pl-6 pr-6">
          <img alt="{{ block.settings.image.alt | escape }}" src="{{ block.settings.image | img_url: '300x' }}" data-src="{{ block.settings.image | img_url: 'master' }}" class="w-full lazyload" />
        </div>
      {% endif %}

      <div class="w-full md:w-8/12 pl-6 pr-6">
        <h3 class="text-2xl font-ubuntu-heavy mb-6">{{ block.settings.name }}</h3>
        <div class="body">{{ block.settings.info }}</div>
        <p class="font-ubuntu-heavy body">Read More: <a class="text-red" target="_blank" href="{{ block.settings.link }}">{{ block.settings.link_text }}</a></p>
        <div class="body">{{ block.settings.info_2 }}</div>
      </div>

      {% if block.settings.image_location == "right" %}
        <div class="w-full md:w-4/12 pl-6 pr-6">
          <img alt="{{ block.settings.image.alt | escape }}" src="{{ block.settings.image | img_url: '300x' }}" data-src="{{ block.settings.image | img_url: 'master' }}" class="w-full lazyload" />
        </div>
      {% endif %}
    </div>
    <hr class="mt-12 mb-12">
  {% endfor %}
</div>

{% schema %}
  {
    "name": "Vendors",
    "class": "mt-20 mb-20 max-w-screen-xl mx-auto",
    "settings": [
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Vendor",
        "settings": [
          {
            "type": "text",
            "id": "category",
            "label": "Page category"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Vendor image"
          },
          {
            "type": "select",
            "id": "image_location",
            "label": "Image position",
            "options": [
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "right",
                "label": "Right"
              }
            ],
            "default": "left"
          },
          {
            "type": "text",
            "id": "name",
            "label": "Vendor name"
          },
          {
            "type": "richtext",
            "id": "info",
            "label": "Vendor info"
          },
          {
            "type": "text",
            "id": "link_text",
            "label": "Vendor name"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Vendor link"
          },
          {
            "type": "richtext",
            "id": "info_2",
            "label": "More vendor info"
          }
        ]
      }
	  ]
  }
{% endschema %}