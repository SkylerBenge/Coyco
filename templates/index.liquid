<style>

#index .svg-1 path{
    animation: scale-path-1 8s ease-in-out infinite;
}
#index .svg-2 path{
    animation: scale-path-2 10s ease-in-out infinite;
}

@keyframes scale-path-1 {
  50% {
    d: path('M64,23 C3,82 329,14 261,69');
  }
}

@keyframes scale-path-2 {
  50% {
    d: path('M30,68 C341,0 344,182 62,17');
  }
}

#index svg polyline,
#index svg line,
#index svg path {
  fill: none;
  stroke-width: 16;
  stroke-linecap: round;
  stroke-linejoin: round;
  transition: 0.2s;
}
#index .svg-1 {
  display: inline-block;
  width: 65%;
}
#index .svg-2 {
  display: inline-block;
  width: 60%;
}
</style>

<div id="index" style="height: 700px; padding-bottom: 26px;" class="grid grid-flow-row grid-rows-4 grid-cols-2 gap-2 m-auto pl-3 pr-3 -mt-32 max-w-screen-2xl">
  <div class="transform scale-115 -rotate-2 translate-y-32 translate-x-20 -z-1">
    <span class="font-platelet-heavy text-8xl uppercase text-black">is</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="svg-1 stroke-current text-red" viewBox="0 0 300 100" preserveAspectRatio="xMidYMid meet">
      <path d="M28,34 C262,15 0,81 286,62" />
    </svg>
  </div>
  <div class="transform -rotate-6 translate-y-32 h-20 pr-20 -translate-x-40 text-right">
    <a href="/collections/frontpage"><button class="bg-red animate-wiggle h-32 px-4 text-9xl leading-4 uppercase font-platelet-heavy tracking-wider text-white rounded hover:bg-black hover:text-cream">Order</button></a>
  </div>
  <div class="transform rotate-6 col-span-2 translate-y-32 pl-28 -z-1">
    <span class="font-platelet-heavy text-10xl uppercase text-black">Portland's</span>
  </div>
  <div class="transform translate-y-40 pl-8">
    <a href="/pages/about-us"><button class="bg-black text-cream animate-bounce px-4 py-2 text-6xl font-platelet-heavy tracking-wider text-white rounded hover:bg-red hover:text-black">About Us</button></a>
  </div>
  <div class="transform text-right -z-1 translate-y-12">
     <svg xmlns="http://www.w3.org/2000/svg" class="svg-2 stroke-current text-red" viewBox="0 0 300 125" preserveAspectRatio="xMidYMid meet">
      <path d="M248,62 C0,0 390,22 19,32" />
    </svg>
  </div>
  <div class="transform col-span-2 translate-y-40 pl-24 leading-4 -rotate-12 -z-1">
    <span class="font-platelet-heavy text-11xl uppercase text-black">sustainable</span>
  </div>
  <div class="transform col-span-2 translate-y-4 -translate-x-28 text-right -z-1">
    <span class="font-platelet-heavy text-10xl uppercase text-black">florist</span>
  </div>
</div>

{% comment %}
{% for product in collections.frontpage.products limit:4 %}
  <div>
    <a href="{{ product.url | within: collection }}">{{ product.title }}</a>
    {{ product.price | money }}
    {% unless product.available %}<br><strong>sold out</strong>{% endunless %}
    <a href="{{ product.url | within: collection }}">
      <img src="{{ product.featured_image.src | img_url: 'large' }}" alt="{{ product.featured_image.alt | escape }}">
    </a>
  </div>
{% endfor %}
{% endcomment %}