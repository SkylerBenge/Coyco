<div class="hidden bg-cream z-2 absolute h-full w-72 mobile-nav__background"></div>
<nav class="flex relative items-start md:items-center md:justify-between py-6 xl:px-6">
  <button class="w-10 mobile-nav__button z-2 md:hidden">{% include 'menu-icon' %}</button>
  <ul class="transition duration-500 nav__links max-w-max absolute z-2 md:static -top-80 left-20">
    {% for link in linklists.main-menu.links %}
      {% assign child_list_handle = link.title | handleize %}
      {% if linklists[child_list_handle].links != blank %}
        <a href="{{ link.url }}">
          {{ link.title }}
        </a>
        [{% for childlink in linklists[child_list_handle].links %}
          <a href="{{ childlink.url }}">
          {{ link.title }}
          </a>
        {% endfor %}]
      {% else %}
      {% if forloop.index == 1 %}
        {% capture nav_classes %}
          "transform rotate-6 md:translate-x-16 lg:translate-x-28"
        {% endcapture %}
      {% elsif forloop.index == 2 %}
        {% capture nav_classes %}
          "transform rotate-30 md:translate-x-14 lg:translate-x-20 translate-y-8 lg:translate-y-10"
        {% endcapture %}
      {% elsif forloop.index == 3 %}
        {% capture nav_classes %}
          "transform rotate-60 -translate-x-14 md:translate-x-0 translate-y-14"
        {% endcapture %}
      {% endif %}
      <li class={{ nav_classes }}>
        <a href="{{ link.url }}">
          <button class="bg-black text-cream px-6 py-3 text-2xl font-dunbar-tall font-semibold tracking-wider text-white rounded hover:bg-red hover:text-black">{{ link.title }}</button>
        </a>
      </li>
      {% endif %}
    {% endfor %}
  </ul>

  <div class="mx-auto max-w-screen-2xl leading-4">
    <div class="transform -rotate-6{% if template == 'index' %} md:-translate-y-4{% else %} translate-y-16{% endif %} col-span-2 text-center">
      {% if template == 'index' %}
        <span class="font-dunbar-tall font-extrabold text-15vw md:text-18vh uppercase text-black -z-1"><a href="/">Coy & CO.</a></span>
      {% else %}
        <span class="font-dunbar-tall font-extrabold text-15vw uppercase text-black -z-1"><a href="/">Coy & CO.</a></span>
      {% endif %}
    </div>
  </div>

  <div class="w-10 sm:w-auto transform z-1 relative -translate-x-1 sm:-translate-x-5 lg:-translate-x-20 overflow-hidden">
    {% unless template == 'index' %}
    <a href="/cart" class="inline-block w-16">{% include 'cart-icon' %}</a>
    <div id="CartCount" class="absolute bottom-0 right-0 px-2 bg-black text-cream rounded {% if cart.item_count == 0 %} hidden{% endif %}">
      <span class="font-platelet-heavy text-sm">{{ cart.item_count }}</span>
    </div>
    {% endunless %}

    {% if shop.customer_accounts_enabled %}
      {% if customer %}
        <a href="/account">account</a>
        {{ 'log out'  | customer_logout_link }}
      {% else %}
        {{ 'log in ' | customer_login_link }}
        {{ 'register' | customer_register_link }}
      {% endif %}
    {% endif %}
  </div>
</nav>

<script>
  $('.mobile-nav__button').click(function() {
    $('.mobile-nav__background').slideToggle("fast");
    if ( $(this).hasClass("isDown") ) {
      $('.nav__links').animate({top: "-=344"}, 250);
    } else {
      $('.nav__links').animate({top: "+=344"}, 500);
    }

    $(this).toggleClass("isDown");
    return false;
  });
</script>